# Database Configuration (Server-only)
# MongoDB connection URI (e.g. MongoDB Atlas replica set or local MongoDB instance)
DB_URI=mongodb+srv://<username>:<password>@<cluster-url>/techsprout?retryWrites=true&w=majority

# Authentication Configuration (Server-only)
# NextAuth / Auth.js encryption secret (generate via `openssl rand -base64 32`)
AUTH_SECRET=your_auth_secret_key_minimum_32_characters
NEXTAUTH_SECRET=your_auth_secret_key_minimum_32_characters

# Application Base URL (Server & Client)
# Local: http://localhost:3000 | Production: https://your-domain.vercel.app
BASE_URL=http://localhost:3000

# Cloudinary Media Platform (Server-only credentials)
CLOUDINARY_CLOUD_NAME=placeholder-cloud-name
CLOUDINARY_API_KEY=placeholder-api-key
CLOUDINARY_API_SECRET=placeholder-api-secret

# Frontend Public Cloudinary Configuration (Optional / Client-safe)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=placeholder-cloud-name
