{
  "name": "techsprout-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:web": "pnpm --filter @techsprout/web dev",
    "dev:api": "pnpm --filter @techsprout/api dev",
    "build": "pnpm --recursive build",
    "build:web": "pnpm --filter @techsprout/web build",
    "build:api": "pnpm --filter @techsprout/api build",
    "build:contracts": "pnpm --filter @techsprout/contracts build",
    "test": "pnpm --recursive test",
    "test:api": "pnpm --filter @techsprout/api test",
    "test:security": "pnpm --filter @techsprout/api test:security",
    "lint": "pnpm --recursive lint",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5"
  }
}
