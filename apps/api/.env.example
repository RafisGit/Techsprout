# NestJS API Environment Variables

# Application
PORT=3001
NODE_ENV=development

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techsprout

# Session / Authentication Secret (Minimum 32 characters)
AUTH_SECRET=development_super_secret_minimum_32_characters_random_string

# Redis (Queue & OTP storage)
REDIS_URL=redis://localhost:6379

# Web Origin (CORS whitelist)
WEB_ORIGIN=http://localhost:3000

# Single canonical public frontend origin for browser redirects (payment callbacks).
# Must be ONE origin (no commas). Required in production.
WEB_PUBLIC_ORIGIN=http://localhost:3000

# Google OAuth 2.0 (Optional in dev)
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-client-secret

# SMS Gateway (Optional in dev)
SMS_GATEWAY_API_KEY=placeholder-sms-api-key

# Cloudinary Media Platform (Server-only credentials)
CLOUDINARY_CLOUD_NAME=placeholder-cloud-name
CLOUDINARY_API_KEY=placeholder-api-key
CLOUDINARY_API_SECRET=placeholder-api-secret

# SSLCommerz Payment Gateway (Server-only credentials)
SSLCOMMERZ_STORE_ID=placeholder_store_id
SSLCOMMERZ_STORE_PASSWORD=placeholder_store_password
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
API_PUBLIC_BASE_URL=http://localhost:3001
SSLCOMMERZ_IS_SANDBOX=true

# Resend Transactional Email (P6.1)
RESEND_API_KEY=re_placeholder_api_key
RESEND_FROM_EMAIL=notifications@techsprout.io
